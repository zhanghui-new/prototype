.login-screen {
  min-height: 100vh;
  background: var(--paper);
  padding: 100rpx 56rpx 60rpx;
  display: flex;
  flex-direction: column;
}

.brand { text-align: center; margin-bottom: 80rpx; }
.logo {
  width: 140rpx; height: 140rpx; border-radius: 40rpx; margin: 0 auto;
  background: linear-gradient(135deg, #B4532A, #8A6A3B);
  display: flex; align-items: center; justify-content: center;
  font-size: 64rpx; font-weight: 900; color: #FFF6EC;
  box-shadow: 0 16rpx 40rpx rgba(180, 83, 42, 0.35);
  font-family: "STSong", serif;
}
.name { font-size: 60rpx; font-weight: 900; margin-top: 28rpx; }
.slogan { font-size: 26rpx; color: var(--ink-faint); margin-top: 12rpx; font-family: "STSong", serif; }

.wb-login-btn {
  height: 96rpx; border-radius: 22rpx; border: none;
  background: linear-gradient(135deg, #C05F33, #B4532A); color: #FFF9F2;
  font-size: 32rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(180, 83, 42, 0.35);
}
.wb-login-btn::after { border: none; }
.wb-error { font-size: 24rpx; color: #e5484d; margin-top: 16rpx; }

.divider {
  display: flex; align-items: center; gap: 20rpx;
  margin: 48rpx 0 32rpx;
}
.divider .line { flex: 1; height: 2rpx; background: var(--line); }
.divider .txt { font-size: 22rpx; color: var(--ink-faint); }

.privacy-note {
  margin-top: auto; text-align: center; font-size: 20rpx;
  color: var(--ink-faint); line-height: 1.7; padding-top: 40rpx;
}
