.timer-screen {
  min-height: 100vh;
  background: linear-gradient(180deg, #242019 0%, #1C1A15 100%);
  color: #F6EFDF;
  display: flex;
  flex-direction: column;
}
.timer-top {
  display: flex; align-items: center; justify-content: space-between;
  padding: 32rpx 40rpx 0;
}
.timer-top .back {
  width: 76rpx; height: 76rpx; border-radius: 22rpx;
  border: 2rpx solid rgba(246, 239, 223, 0.25); background: rgba(246, 239, 223, 0.1);
  display: flex; align-items: center; justify-content: center; font-size: 34rpx; color: #F6EFDF;
}
.timer-top .tip { font-size: 22rpx; color: rgba(246, 239, 223, 0.4); }

.timer-body {
  flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 0 64rpx;
}
.timer-book {
  width: 220rpx; height: 308rpx; border-radius: 20rpx; margin-bottom: 72rpx;
  animation: float 4s ease-in-out infinite;
}
.timer-book .bt { font-size: 30rpx; }
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-16rpx); }
}
.timer-label { font-size: 24rpx; letter-spacing: 6rpx; color: rgba(246, 239, 223, 0.5); margin-bottom: 28rpx; }
.timer-digits {
  font-size: 152rpx; font-weight: 900; letter-spacing: 2rpx; line-height: 1;
  font-variant-numeric: tabular-nums;
}
.timer-digits .dot { animation: blink 1s infinite; }
@keyframes blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0.25; } }
.timer-sub { margin-top: 32rpx; font-size: 26rpx; color: rgba(246, 239, 223, 0.6); }
.timer-goal { margin-top: 12rpx; font-size: 24rpx; color: #E0A458; }

.timer-actions { display: flex; gap: 28rpx; padding: 0 48rpx 80rpx; }
.btn-round {
  width: 128rpx; height: 128rpx; border-radius: 50%;
  border: 3rpx solid rgba(246, 239, 223, 0.3); background: rgba(246, 239, 223, 0.08);
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx;
}
.btn-round .ico { font-size: 40rpx; }
.btn-round .txt { font-size: 22rpx; }
.btn-finish {
  flex: 1; height: 128rpx; border-radius: 999rpx; border: none;
  background: linear-gradient(135deg, #C05F33, #B4532A); color: #FFF6EC;
  font-size: 32rpx; font-weight: 700;
  box-shadow: 0 16rpx 48rpx rgba(180, 83, 42, 0.45);
  display: flex; align-items: center; justify-content: center;
}
.btn-finish::after { border: none; }
