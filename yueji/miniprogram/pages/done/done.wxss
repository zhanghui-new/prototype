.done-screen {
  min-height: 100vh;
  background: radial-gradient(140% 90% at 50% 0%, #FBEFE2 0%, var(--paper) 55%);
  padding-bottom: 40rpx;
}
.done-hero { text-align: center; padding: 60rpx 40rpx 20rpx; }
.seal {
  width: 232rpx; height: 232rpx; margin: 0 auto; border-radius: 50%;
  background: radial-gradient(circle at 32% 28%, #D08A5C, #B4532A 65%);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 32rpx 72rpx rgba(180, 83, 42, 0.4), inset 0 0 0 10rpx rgba(255, 255, 255, 0.18);
}
.seal .tick { font-size: 104rpx; color: #FFF6EC; font-weight: 900; }
.seal.pop { animation: seal-pop 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) both; }
@keyframes seal-pop {
  0% { transform: scale(0.3); opacity: 0; }
  60% { transform: scale(1.12); }
  100% { transform: scale(1); opacity: 1; }
}
.done-hero .h1 { font-size: 54rpx; font-weight: 900; margin-top: 40rpx; letter-spacing: 2rpx; }
.done-hero .sub { font-size: 26rpx; color: var(--ink-soft); margin-top: 16rpx; line-height: 1.7; white-space: pre-line; }
.done-hero .sub .b { color: var(--green); font-weight: 700; }
.spark-row { display: flex; justify-content: center; gap: 28rpx; margin-top: 32rpx; }
.spark {
  text-align: center; background: var(--surface); border-radius: 20rpx;
  box-shadow: var(--shadow-card); padding: 20rpx 36rpx;
}
.spark .v { font-size: 38rpx; font-weight: 900; color: var(--primary); }
.spark .k { font-size: 20rpx; color: var(--ink-faint); margin-top: 4rpx; }

.note-card { margin: 36rpx 40rpx 0; }
.nq {
  font-size: 26rpx; line-height: 1.8; color: var(--ink-soft); padding: 28rpx 32rpx;
  background: var(--paper-deep); border-radius: 20rpx; font-family: "STSong", serif;
}
.note-input {
  width: 100%; min-height: 128rpx; margin-top: 20rpx; border: 3rpx solid var(--line);
  border-radius: 20rpx; padding: 24rpx 28rpx; font-size: 27rpx; line-height: 1.7;
  color: var(--ink); background: var(--surface); box-sizing: border-box;
}
.mood-row { display: flex; justify-content: space-between; margin: 32rpx 4rpx 0; }
.mood { display: flex; flex-direction: column; align-items: center; gap: 12rpx; font-size: 21rpx; color: var(--ink-faint); }
.mood .face {
  width: 92rpx; height: 92rpx; border-radius: 50%; background: var(--paper-deep);
  display: flex; align-items: center; justify-content: center; font-size: 42rpx;
  transition: all 0.2s;
}
.mood.on { color: var(--primary); font-weight: 700; }
.mood.on .face { background: var(--primary-soft); box-shadow: 0 0 0 5rpx var(--primary); transform: scale(1.1); }
.stars { display: flex; justify-content: center; gap: 16rpx; margin: 32rpx 0 12rpx; }
.star { font-size: 52rpx; color: #DCD3C2; }
.star.on { color: var(--amber); text-shadow: 0 4rpx 16rpx rgba(201, 143, 46, 0.45); }

.done-actions { margin: 24rpx 40rpx 0; display: flex; flex-direction: column; gap: 20rpx; }
