.nav { display: flex; align-items: center; height: 88rpx; padding-bottom: 8rpx; border-bottom: 2rpx solid var(--line); background: var(--paper); }
.nav-back { width: 88rpx; text-align: center; font-size: 56rpx; line-height: 1; color: var(--ink-soft); }
.nav-title { flex: 1; text-align: center; font-size: 32rpx; font-weight: 700; }
.nav-slot { width: 88rpx; }

.form { padding: 40rpx; }
.field { margin-bottom: 44rpx; position: relative; }
.lb { font-size: 27rpx; font-weight: 700; color: var(--ink); margin-bottom: 16rpx; }
.lb .opt { font-size: 21rpx; color: var(--ink-faint); font-weight: 400; margin-left: 10rpx; }
.input {
  width: 100%; min-height: 92rpx; padding: 22rpx 26rpx;
  background: var(--surface); border: 2rpx solid var(--line); border-radius: 18rpx;
  font-size: 27rpx; color: var(--ink);
}
.hint { font-size: 21rpx; color: var(--ink-faint); margin-top: 12rpx; text-align: right; }
.field:first-child .hint { position: absolute; right: 0; bottom: -4rpx; }

.stepper { display: flex; align-items: center; gap: 32rpx; }
.step-btn {
  width: 84rpx; height: 84rpx; border-radius: 50%;
  background: var(--paper-deep); color: var(--primary);
  display: flex; align-items: center; justify-content: center;
  font-size: 44rpx; font-weight: 300;
}
.step-val { font-size: 52rpx; font-weight: 900; min-width: 220rpx; text-align: center; color: var(--primary); }
.step-val .unit { font-size: 24rpx; font-weight: 400; color: var(--ink-soft); }

.chips { display: flex; flex-wrap: wrap; gap: 18rpx; }
.chip {
  padding: 16rpx 34rpx; border-radius: 999rpx; font-size: 25rpx;
  background: var(--surface); border: 2rpx solid var(--line); color: var(--ink-soft);
}
.chip.on { background: var(--primary-soft); border-color: var(--primary); color: var(--primary); font-weight: 700; }

.tip-card {
  background: var(--green-soft); border-radius: 20rpx; padding: 28rpx 30rpx; margin: 8rpx 0 48rpx;
}
.tip-t { font-size: 26rpx; font-weight: 700; color: var(--green); }
.tip-d { font-size: 23rpx; line-height: 1.7; color: var(--ink-soft); margin-top: 10rpx; }

.submit { width: 100%; }
.disabled { opacity: .6; }
