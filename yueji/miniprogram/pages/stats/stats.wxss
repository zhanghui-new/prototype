.big-streak {
  margin: 32rpx 40rpx 0; background: linear-gradient(135deg, #2D6A4F, #1E4A36);
  border-radius: 40rpx; padding: 40rpx; color: #EDF5EF; position: relative; overflow: hidden;
  box-shadow: 0 20rpx 52rpx rgba(45, 106, 79, 0.32);
}
.big-streak::after {
  content: '🔥'; position: absolute; right: -16rpx; bottom: -32rpx; font-size: 220rpx; opacity: 0.12;
}
.big-streak .row1 { display: flex; align-items: baseline; gap: 16rpx; }
.big-streak .num { font-size: 88rpx; font-weight: 900; line-height: 1; color: #F6E9CF; }
.big-streak .unit { font-size: 26rpx; opacity: 0.8; }
.big-streak .cap { font-size: 25rpx; opacity: 0.85; margin-top: 16rpx; line-height: 1.6; white-space: pre-line; }
.big-streak .recents { display: flex; gap: 12rpx; margin-top: 28rpx; }
.recents .dot {
  width: 52rpx; height: 52rpx; border-radius: 16rpx; background: rgba(255, 255, 255, 0.16);
  display: flex; align-items: center; justify-content: center; font-size: 24rpx;
}
.recents .dot.on { background: #E0A458; color: #3D2B00; font-weight: 700; }

.heat-wrap { margin: 32rpx 40rpx 0; padding: 40rpx; }
.heat-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 28rpx; }
.heat-head .m { font-weight: 700; font-size: 30rpx; }
.heat-head .legend { font-size: 20rpx; color: var(--ink-faint); }
.heat { display: flex; flex-wrap: wrap; gap: 14rpx; }
.heat .cell {
  width: calc((100% - 84rpx) / 7); aspect-ratio: 1; border-radius: 10rpx;
  background: var(--paper-deep);
}
.heat .cell.l1 { background: #EBDCC8; }
.heat .cell.l2 { background: #E0BFA6; }
.heat .cell.l3 { background: #D08A5C; }
.heat .cell.l4 { background: #B4532A; }
.heat .cell.skip { background: transparent; box-shadow: inset 0 0 0 3rpx var(--line); border-radius: 50%; }
.heat .cell.today { box-shadow: 0 0 0 5rpx var(--amber); }
.heat-days { display: flex; margin-top: 14rpx; }
.heat-days text { flex: 1; text-align: center; font-size: 19rpx; color: var(--ink-faint); }

.stat-rows { margin: 0 40rpx; padding: 12rpx 40rpx; }
.srow { display: flex; justify-content: space-between; align-items: center; padding: 30rpx 8rpx; border-bottom: 2rpx solid var(--line); }
.srow:last-child { border-bottom: none; }
.srow .l { display: flex; align-items: center; gap: 24rpx; font-size: 28rpx; font-weight: 500; }
.srow .ico { width: 76rpx; height: 76rpx; border-radius: 22rpx; display: flex; align-items: center; justify-content: center; font-size: 34rpx; }
.srow .ico.i1 { background: var(--primary-soft); }
.srow .ico.i2 { background: var(--green-soft); }
.srow .ico.i3 { background: var(--amber-soft); }
.srow .ico.i4 { background: #E7E3F4; }
.srow .r { text-align: right; }
.srow .rv { font-size: 36rpx; font-weight: 900; }
.srow .rv .u { font-size: 22rpx; }
.srow .rv.c1 { color: var(--primary); }
.srow .rv.c2 { color: var(--green); }
.srow .rv.c3 { color: var(--amber); }
.srow .rv.c4 { color: #6A5FA8; }
.srow .rk { font-size: 21rpx; color: var(--ink-faint); margin-top: 4rpx; }
