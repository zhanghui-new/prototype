.nav { display: flex; align-items: center; height: 88rpx; padding-bottom: 8rpx; border-bottom: 2rpx solid var(--line); background: var(--paper); }
.nav-back { width: 88rpx; text-align: center; font-size: 56rpx; line-height: 1; color: var(--ink-soft); }
.nav-title { flex: 1; text-align: center; font-size: 32rpx; font-weight: 700; }
.nav-slot { width: 88rpx; }

.room-head {
  margin: 24rpx 32rpx 0; padding: 32rpx; border-radius: 26rpx;
  background: linear-gradient(150deg, #2D6A4F, #1B4332); color: #FFF6EC;
  box-shadow: var(--shadow-card);
}
.rh-line { display: flex; gap: 24rpx; align-items: center; }
.mini-c.big { width: 84rpx; height: 116rpx; border-radius: 10rpx; flex-shrink: 0; box-shadow: 0 4rpx 14rpx rgba(0,0,0,.25); }
.rh-info { flex: 1; min-width: 0; }
.rh-name { font-size: 36rpx; font-weight: 700; letter-spacing: 1rpx; }
.rh-book { font-size: 24rpx; opacity: .9; margin-top: 6rpx; }
.rh-owner { font-size: 21rpx; opacity: .65; margin-top: 6rpx; }
.rh-metrics { display: flex; margin-top: 32rpx; padding-top: 26rpx; border-top: 2rpx solid rgba(255,246,236,.18); }
.metric { flex: 1; text-align: center; }
.m-num { font-size: 44rpx; font-weight: 900; }
.m-slash { font-size: 24rpx; opacity: .7; font-weight: 400; }
.m-lb { font-size: 21rpx; opacity: .7; margin-top: 4rpx; }
.goal-bar { height: 10rpx; border-radius: 5rpx; background: rgba(255,246,236,.2); margin-top: 26rpx; overflow: hidden; }
.goal-fill { height: 100%; border-radius: 5rpx; background: var(--amber); }
.goal-caption { font-size: 21rpx; opacity: .75; margin-top: 10rpx; text-align: right; }

.invite-card {
  display: flex; align-items: center; margin: 20rpx 32rpx 0; padding: 26rpx 30rpx;
  background: var(--amber-soft); border-radius: 22rpx;
}
.ic-left { flex: 1; }
.ic-t { font-size: 23rpx; color: var(--ink-soft); }
.ic-code { font-size: 44rpx; font-weight: 900; letter-spacing: 8rpx; color: var(--primary); margin-top: 6rpx; }
.ic-actions { display: flex; flex-direction: column; gap: 12rpx; }
.ic-btn {
  font-size: 22rpx; font-weight: 600; color: #FFF6EC; background: var(--primary);
  padding: 12rpx 22rpx; border-radius: 999rpx; text-align: center;
}
.ic-btn.ghost { background: transparent; color: var(--primary); border: 2rpx solid var(--primary); padding: 10rpx 20rpx; }

.today-card {
  display: flex; align-items: center; gap: 20rpx; margin: 20rpx 32rpx 0;
  padding: 26rpx 30rpx; background: var(--surface); border-radius: 22rpx;
  box-shadow: var(--shadow-card); border-left: 6rpx solid var(--amber);
}
.today-card.done { border-left-color: var(--green); }
.tc-left { flex: 1; min-width: 0; }
.tc-title { font-size: 27rpx; font-weight: 700; }
.tc-desc { font-size: 21rpx; color: var(--ink-faint); margin-top: 6rpx; }
.tc-btn { font-size: 24rpx; font-weight: 700; color: #FFF6EC; background: var(--primary); padding: 16rpx 30rpx; border-radius: 999rpx; }
.tc-check { font-size: 40rpx; font-weight: 700; color: var(--green); }

.members-sec { margin-top: 34rpx; }
.sec-hd { font-size: 27rpx; font-weight: 700; padding: 0 40rpx 16rpx; }
.sec-hd .cnt { font-size: 20rpx; color: var(--ink-faint); font-weight: 400; margin-left: 12rpx; }
.member-row {
  display: flex; gap: 22rpx; align-items: center;
  margin: 0 32rpx 14rpx; padding: 22rpx 24rpx;
  background: var(--surface); border-radius: 20rpx; box-shadow: var(--shadow-card);
}
.m-ava {
  width: 76rpx; height: 76rpx; border-radius: 50%; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; font-weight: 700; color: #FFF6EC; font-family: "STSong", serif;
}
.m-ava.a1 { background: linear-gradient(135deg, #B4532A, #8A3B1E); }
.m-ava.a2 { background: linear-gradient(135deg, #2D6A4F, #1E4A36); }
.m-ava.a3 { background: linear-gradient(135deg, #39586E, #21303E); }
.m-ava.a4 { background: linear-gradient(135deg, #C98F2E, #8A6218); }
.m-body { flex: 1; min-width: 0; }
.m-top { display: flex; align-items: center; gap: 12rpx; }
.m-name { font-size: 27rpx; font-weight: 700; }
.m-tag { font-size: 18rpx; color: var(--primary); background: var(--primary-soft); padding: 2rpx 12rpx; border-radius: 999rpx; }
.m-tag.me { color: var(--green); background: var(--green-soft); }
.m-today { font-size: 19rpx; color: var(--ink-faint); margin-left: auto; }
.m-today.on { color: var(--green); font-weight: 600; }
.m-progress { height: 8rpx; border-radius: 4rpx; background: var(--paper-deep); margin-top: 12rpx; overflow: hidden; }
.m-fill { height: 100%; border-radius: 4rpx; background: var(--green); }
.m-sub { font-size: 20rpx; color: var(--ink-faint); margin-top: 8rpx; }

.leave-btn { text-align: center; font-size: 24rpx; color: var(--ink-faint); padding: 40rpx 0 10rpx; text-decoration: underline; }
.bottom-space { height: 40rpx; }

.mask { position: fixed; inset: 0; background: rgba(0,0,0,.42); z-index: 90; }
.sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 100;
  background: var(--paper); border-radius: 32rpx 32rpx 0 0; padding-bottom: 40rpx;
}
.sheet-hd { display: flex; align-items: center; justify-content: space-between; padding: 32rpx 40rpx 20rpx; border-bottom: 2rpx solid var(--line); }
.sheet-title { font-size: 32rpx; font-weight: 700; }
.sheet-close { font-size: 48rpx; color: var(--ink-faint); line-height: 1; }
.sheet-body { padding: 32rpx 40rpx 0; }
.field-label { font-size: 26rpx; font-weight: 700; }
.field-label.mt { margin-top: 36rpx; }
.field-label .opt { font-size: 20rpx; color: var(--ink-faint); font-weight: 400; margin-left: 10rpx; }
.stepper { display: flex; align-items: center; gap: 32rpx; margin-top: 20rpx; }
.step-btn { width: 84rpx; height: 84rpx; border-radius: 50%; background: var(--paper-deep); color: var(--primary); display: flex; align-items: center; justify-content: center; font-size: 44rpx; }
.step-val { font-size: 52rpx; font-weight: 900; min-width: 220rpx; text-align: center; color: var(--primary); }
.step-val .unit { font-size: 24rpx; color: var(--ink-soft); font-weight: 400; }
.note-input { width: 100%; min-height: 140rpx; margin-top: 16rpx; padding: 22rpx 24rpx; background: var(--surface); border: 2rpx solid var(--line); border-radius: 18rpx; font-size: 26rpx; }
.sheet-tip { font-size: 21rpx; color: var(--ink-faint); margin: 20rpx 0 32rpx; }
.sheet-submit { width: 100%; }
.disabled { opacity: .6; }
