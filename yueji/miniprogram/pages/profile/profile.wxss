.me-head { display: flex; align-items: center; gap: 32rpx; padding: 40rpx; }
.me-ava {
  width: 148rpx; height: 148rpx; border-radius: 44rpx; flex-shrink: 0;
  background: linear-gradient(135deg, #B4532A, #8A6A3B);
  display: flex; align-items: center; justify-content: center;
  font-size: 54rpx; font-weight: 900; color: #FFF6EC;
  box-shadow: 0 16rpx 40rpx rgba(180, 83, 42, 0.35);
  font-family: "STSong", serif;
}
.me-ava.a1 { background: linear-gradient(135deg, #B4532A, #8A3B1E); }
.me-ava.a2 { background: linear-gradient(135deg, #2D6A4F, #1E4A36); }
.me-ava.a3 { background: linear-gradient(135deg, #39586E, #21303E); }
.me-ava.a4 { background: linear-gradient(135deg, #C98F2E, #8A6218); }
.me-info { flex: 1; min-width: 0; }
.me-info .nm { display: flex; align-items: center; gap: 16rpx; font-size: 42rpx; font-weight: 900; }
.me-info .lv {
  font-size: 21rpx; background: var(--ink); color: var(--paper);
  padding: 6rpx 20rpx; border-radius: 999rpx; font-weight: 600; letter-spacing: 1rpx;
}
.me-info .sig { font-size: 24rpx; color: var(--ink-faint); margin-top: 12rpx; font-family: "STSong", serif; }
.me-stats { display: flex; margin-top: 24rpx; }
.me-stat { flex: 1; }
.me-stat + .me-stat { border-left: 2rpx solid var(--line); padding-left: 28rpx; }
.me-stat .v { font-size: 38rpx; font-weight: 900; font-family: "STSong", serif; }
.me-stat .v .u { font-size: 21rpx; font-weight: 400; color: var(--ink-faint); }
.me-stat .k { font-size: 21rpx; color: var(--ink-faint); margin-top: 2rpx; }
.me-stat .v.c1 { color: var(--primary); }
.me-stat .v.c2 { color: var(--green); }
.me-stat .v.c3 { color: var(--amber); }

.login-bar {
  margin: 24rpx 40rpx 0; padding: 28rpx 32rpx;
  background: var(--surface); border-radius: 24rpx; box-shadow: var(--shadow-card);
  display: flex; align-items: center; justify-content: space-between;
}
.login-bar-txt { font-size: 26rpx; color: var(--ink-soft); flex: 1; }
.login-bar-btn {
  font-size: 24rpx; color: var(--primary); font-weight: 600;
  padding: 10rpx 28rpx; border-radius: 999rpx; background: var(--primary-soft);
}

.year-card {
  margin: 12rpx 40rpx 0; background: linear-gradient(135deg, #3A3428, #1C1A15);
  color: #F6EFDF; border-radius: 40rpx; padding: 40rpx; position: relative; overflow: hidden;
  box-shadow: 0 20rpx 56rpx rgba(28, 26, 21, 0.3);
}
.year-card::after {
  content: '📚'; position: absolute; right: -20rpx; top: -28rpx; font-size: 176rpx; opacity: 0.1;
}
.year-card .cap { font-size: 23rpx; letter-spacing: 5rpx; color: rgba(246, 239, 223, 0.55); }
.year-card .row { display: flex; align-items: baseline; gap: 12rpx; margin-top: 16rpx; }
.year-card .n { font-size: 72rpx; font-weight: 900; color: #E0A458; }
.year-card .u { font-size: 25rpx; opacity: 0.75; }
.year-card .pr { font-size: 24rpx; opacity: 0.8; margin-left: auto; }
.year-card .track { height: 16rpx; background: rgba(255, 255, 255, 0.14); border-radius: 999rpx; margin-top: 28rpx; overflow: hidden; }
.year-card .track .fill { height: 100%; width: 50%; border-radius: 999rpx; background: linear-gradient(90deg, #C98F2E, #E0A458); }
.year-card .marks { display: flex; justify-content: space-between; margin-top: 16rpx; font-size: 20rpx; opacity: 0.5; }

.badge-grid { display: flex; flex-wrap: wrap; padding: 12rpx 40rpx 16rpx; }
.badge { width: 25%; text-align: center; margin-bottom: 32rpx; }
.b-ico {
  width: 112rpx; height: 112rpx; margin: 0 auto; border-radius: 34rpx;
  display: flex; align-items: center; justify-content: center; font-size: 50rpx; position: relative;
}
.badge.got .b-ico {
  background: linear-gradient(135deg, var(--amber-soft), #EAD9B0);
  box-shadow: 0 10rpx 28rpx rgba(201, 143, 46, 0.3), inset 0 0 0 3rpx rgba(201, 143, 46, 0.4);
}
.badge:not(.got) .b-ico { background: var(--paper-deep); filter: grayscale(1); opacity: 0.45; }
.b-ico .lock {
  position: absolute; right: -6rpx; bottom: -6rpx; width: 34rpx; height: 34rpx; border-radius: 50%;
  background: var(--ink-faint); font-size: 18rpx; display: flex; align-items: center; justify-content: center;
}
.b-nm { font-size: 21rpx; margin-top: 12rpx; color: var(--ink-soft); }
.badge.got .b-nm { color: var(--ink); font-weight: 600; }

.set-list {
  margin: 24rpx 40rpx 40rpx; background: var(--surface); border-radius: 24rpx;
  box-shadow: var(--shadow-card); overflow: hidden;
}
.set-item {
  display: flex; align-items: center; gap: 24rpx; padding: 30rpx 36rpx;
  font-size: 28rpx; border-bottom: 2rpx solid var(--line);
}
.set-item:last-child { border-bottom: none; }
.s-ico {
  width: 68rpx; height: 68rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; font-size: 32rpx;
}
.s-ico.i1 { background: var(--primary-soft); }
.s-ico.i2 { background: var(--green-soft); }
.s-ico.i3 { background: var(--amber-soft); }
.s-ico.i4 { background: #E7E3F4; }
.s-ico.i5 { background: #E3EBF0; }
.s-ico.i6 { background: var(--primary-soft); color: var(--primary); }
.set-item .val { margin-left: auto; font-size: 25rpx; color: var(--ink-faint); }
.set-item .arrow { margin-left: 8rpx; color: var(--ink-faint); font-size: 28rpx; }

.switch {
  width: 92rpx; height: 54rpx; border-radius: 999rpx; background: var(--line);
  margin-left: auto; position: relative; transition: background 0.25s; flex-shrink: 0;
}
.switch::after {
  content: ''; position: absolute; left: 5rpx; top: 5rpx; width: 44rpx; height: 44rpx;
  border-radius: 50%; background: #fff; box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.2);
  transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.switch.on { background: var(--green); }
.switch.on::after { transform: translateX(38rpx); }
